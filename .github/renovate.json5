{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    'helpers:pinGitHubActionDigests',
  ],
  platformAutomerge: true,
  postUpdateOptions: ['gomodTidy'],
  packageRules: [
    {
      description: 'Automerge minor/patch GitHub Actions updates',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
    {
      description: 'Bump the go.mod go directive with Go releases',
      matchManagers: ['gomod'],
      matchDepTypes: ['golang'],
      matchDepNames: ['go'],
      rangeStrategy: 'bump',
    },
    {
      description: 'Automerge minor/patch Go toolchain updates',
      matchManagers: ['gomod'],
      matchDepTypes: ['golang'],
      matchDepNames: ['go'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'Go toolchain',
      automerge: true,
    },
    {
      description: 'Automerge patch direct Go module updates',
      matchManagers: ['gomod'],
      matchDepTypes: ['require'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      description: 'Do not automerge high-risk GitOps renderer module updates',
      matchManagers: ['gomod'],
      matchPackageNames: [
        '/^github\\.com\\/argoproj\\/argo-cd/',
        '/^helm\\.sh\\/helm/',
        '/^k8s\\.io\\//',
        '/^sigs\\.k8s\\.io\\/kustomize/',
      ],
      automerge: false,
    },
    {
      description: 'Enable indirect Go module updates for golang.org/x modules',
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      matchDepNames: ['/^golang\\.org\\/x\\//'],
      enabled: true,
    },
    {
      description: 'Keep non-golang.org/x indirect Go module updates disabled',
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      matchDepNames: ['!/^(golang\\.org\\/x\\/)/'],
      enabled: false,
    },
    {
      description: 'Automerge minor/patch indirect golang.org/x module updates',
      matchManagers: ['gomod'],
      matchDepTypes: ['indirect'],
      matchDepNames: ['/^golang\\.org\\/x\\//'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      description: 'Automerge minor/patch CI tool updates',
      matchPackageNames: [
        'rhysd/actionlint',
        'markdownlint-cli2',
        'golang/vuln',
        'goreleaser/goreleaser',
        'sigstore/cosign',
        'anchore/syft',
      ],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: ['Process go run tool versions in mise tasks'],
      managerFilePatterns: ['/^\\.mise\\.toml$/'],
      matchStrings: [
        'go run github\\.com/(?<depName>[\\w-]+/[\\w-]+)/.+@v(?<currentValue>[\\d.]+)',
      ],
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      description: ['Process govulncheck version in mise tasks'],
      managerFilePatterns: ['/^\\.mise\\.toml$/'],
      matchStrings: [
        'go run golang\\.org/x/vuln/cmd/govulncheck@v(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'golang/vuln',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      description: ['Process npx tool versions in mise tasks'],
      managerFilePatterns: ['/^\\.mise\\.toml$/'],
      matchStrings: [
        'npx --yes (?<depName>[\\w-]+)@(?<currentValue>[\\d.]+)',
      ],
      datasourceTemplate: 'npm',
      versioningTemplate: 'npm',
    },
  ],
}
